ANTHROPIC_API_KEY=...
OPENAI_API_KEY=...
ELEVENLABS_API_KEY=...
CORS_ORIGIN=https://votre-frontend.vercel.app

# Vérification par SMS (EnvoiSMS.ma ou autre)
SMS_PROVIDER_URL=https://api.envoisms.ma/v1/messages
SMS_PROVIDER_API_KEY=...

# Vérification par email (SMTP classique — ex. Gmail + mot de passe d'application)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=votre.adresse@gmail.com
SMTP_PASS=le-mot-de-passe-dapplication-genere-par-google
EMAIL_FROM=AI Video Creator <votre.adresse@gmail.com>

OTP_TOKEN_SECRET=une-longue-chaine-aleatoire-a-generer-vous-meme

# Prix (modifiables à tout moment, sans toucher au code)
PRICE_SINGLE_USD=2.00
PRICE_SUBSCRIPTION_USD=1.00
PRICE_SINGLE_MAD=20
PRICE_SUBSCRIPTION_MAD=10

# PayPal (sandbox d'abord : https://developer.paypal.com)
PAYPAL_CLIENT_ID=...
PAYPAL_CLIENT_SECRET=...
PAYPAL_ENV=sandbox
PAYPAL_RETURN_BASE_URL=https://votre-backend.up.railway.app

# Stripe (mode test d'abord : https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# CMI (fourni par la banque à l'affiliation marchand — voir kit d'intégration)
CMI_STORE_ID=...
CMI_STORE_KEY=...
CMI_GATEWAY_URL=...
CMI_RETURN_BASE_URL=https://votre-backend.up.railway.app
